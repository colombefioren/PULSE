# Copy to .env to override the development defaults used by docker-compose.yml.
# .env is git-ignored. Never commit real credentials.

# PostgreSQL
POSTGRES_USER=pulse
POSTGRES_PASSWORD=pulse_dev_password
POSTGRES_DB=pulse
POSTGRES_PORT=5432

# Host ports
API_PORT=5080
WEB_PORT=8080
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# Vite dev server proxy target (npm run dev inside web/)
PULSE_API_URL=http://localhost:5080
